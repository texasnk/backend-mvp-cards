PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/backend_mvp_cards
OPENAI_API_KEY=replace-me
OPENAI_MODEL_TEXT=gpt-4.1-mini
OPENAI_MODEL_VISION=gpt-4.1-mini
MAX_FILE_SIZE_MB=10
MAX_TEXT_CHARS=10000
MAX_CARDS_PER_REQUEST=10
DEFAULT_CARDS_PER_REQUEST=3
REQUEST_TIMEOUT_MS=30000
ALLOWED_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
DOMAIN_MATCH_THRESHOLD=0.8
PROCESSING_RATE_LIMIT_MAX_REQUESTS=20
PROCESSING_RATE_LIMIT_WINDOW_MS=60000
MAX_PDF_PAGES=40
MAX_IMAGE_WIDTH=1280
MAX_IMAGE_HEIGHT=720
BODY_LIMIT=1mb

